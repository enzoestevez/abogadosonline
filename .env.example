# Copiá estas variables en el panel de Vercel (Project Settings > Environment
# Variables). NUNCA subas un archivo .env real con valores reales a GitHub.

# --- Base de datos (ya la tenías funcionando con Manus/TiDB) ---
DATABASE_URL=mysql://usuario:password@host:4000/nombre_db?ssl={"rejectUnauthorized":true}

# --- Mercado Pago ---
# Access Token de PRODUCCIÓN (Panel de desarrolladores de Mercado Pago >
# Tus integraciones > Credenciales de producción). Empieza con APP_USR-...
MP_ACCESS_TOKEN=

# URL pública del sitio, SIN barra al final. Se usa para las back_urls de
# Mercado Pago y para armar la URL del webhook.
PUBLIC_SITE_URL=https://eabogadosonline.com

# --- Legado de Manus (login/OAuth) ---
# El sitio público no usa login, así que estas variables no son necesarias.
# Se dejan documentadas por si en algún momento se reactiva esa función.
# JWT_SECRET=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# VITE_APP_ID=
